# ==========================================
# LLM 配置（通用 OpenAI 兼容格式）
# ==========================================
# 支持任何 OpenAI 兼容 API，改这三行就能切换：

LLM_API_KEY=你的API_Key
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# 可选：强模型（复杂任务用，不设则和 LLM_MODEL 一样）
# LLM_MODEL_STRONG=gpt-4o

# ==========================================
# 切模型示例（取消注释即可）
# ==========================================

# --- MiniMax ---
# LLM_API_KEY=你的MiniMax_Key
# LLM_API_BASE=https://api.minimaxi.com/v1
# LLM_MODEL=MiniMax-M2.7

# --- 智谱 GLM ---
# LLM_API_KEY=你的智谱_Key
# LLM_API_BASE=https://open.bigmodel.cn/api/coding/paas/v4
# LLM_MODEL=glm-5.1

# --- DeepSeek ---
# LLM_API_KEY=你的DeepSeek_Key
# LLM_API_BASE=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# --- 通义千问 ---
# LLM_API_KEY=你的千问_Key
# LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# --- Ollama 本地 ---
# LLM_API_KEY=ollama
# LLM_API_BASE=http://localhost:11434/v1
# LLM_MODEL=gemma4:e4b

# ==========================================
# 联网搜索配置
# ==========================================
SEARCH_ENGINE=searxng
SEARXNG_BASE_URL=http://localhost:8888
SEARCH_FALLBACK=duckduckgo
