# ==========================================
# LLM API 配置
# ==========================================

# 当前使用的模型提供商：ollama / glm / minimax（只改这一行就能切换）
PROVIDER=

# Ollama 本地模型
OLLAMA_API_KEY=ollama
OLLAMA_API_BASE=http://localhost:11434/v1
OLLAMA_MODEL=gemma4:e4b

# 智谱 GLM API（https://open.bigmodel.cn/）
GLM_API_KEY=你的智谱API_Key
GLM_API_BASE=https://open.bigmodel.cn/api/coding/paas/v4

# MiniMax API（https://www.minimaxi.com/）
MINIMAX_API_KEY=你的MiniMax_API_Key
MINIMAX_API_BASE=https://api.minimaxi.com/v1

# ==========================================
# 联网搜索配置
# ==========================================

# 主搜索引擎：searxng / duckduckgo
SEARCH_ENGINE=searxng

# SearXNG 服务地址（Docker 部署后改这里）
SEARXNG_BASE_URL=http://localhost:8888

# 备用搜索引擎（主引擎不可用时自动降级）
SEARCH_FALLBACK=duckduckgo

# ==========================================
# 工具 API（可选）
# ==========================================
# 和风天气（可选，项目已内置免费 wttr.in）
# QWEATHER_KEY=你的和风天气Key
