# ══════════════════════════════════════════════════════════════════════
# 当前激活的模型（名称对应下面 MODEL_<名称>_ 的前缀）
# ══════════════════════════════════════════════════════════════════════
ACTIVE_MODEL=minimax

# ══════════════════════════════════════════════════════════════════════
# 工具锚定验证（true/false）— 零API调用，毫秒级完成
# 检查项：Python 语法、JSON 格式
# ══════════════════════════════════════════════════════════════════════
REFLECTION=true

# ══════════════════════════════════════════════════════════════════════
# 模型配置（MODEL_<名称>_<字段>）
#   字段: KEY = API密钥, BASE = 接口地址, ID = 模型名
#   名称随便取，用 /models 切换时引用这个名称
#   要加新模型？照着格式加三行就行
#
#   继承：同供应商多模型时，用 INHERIT 复用 KEY/BASE，只换 ID
#     MODEL_<名称>_INHERIT=基础模型名
#     MODEL_<名称>_ID=另一个模型ID
# ══════════════════════════════════════════════════════════════════════

# ═══════════ MiniMax 系列 ═══════════
# M2.7（基础，写完整配置）
MODEL_MINIMAX_KEY=你的MiniMax_Key
MODEL_MINIMAX_BASE=https://api.minimaxi.com/v1
MODEL_MINIMAX_ID=MiniMax-M2.7

# M2.5（继承 MiniMax 的 KEY/BASE，只换模型 ID）
# MODEL_MINIMAX_25_INHERIT=minimax
# MODEL_MINIMAX_25_ID=MiniMax-M2.5

# ═══════════ 智谱系列 ═══════════
# GLM-5.1
# MODEL_GLM_KEY=你的智谱_Key
# MODEL_GLM_BASE=https://open.bigmodel.cn/api/coding/paas/v4
# MODEL_GLM_ID=glm-5.1

# ═══════════ DeepSeek 系列 ═══════════
# MODEL_DEEPSEEK_KEY=你的DeepSeek_Key
# MODEL_DEEPSEEK_BASE=https://api.deepseek.com/v1
# MODEL_DEEPSEEK_ID=deepseek-chat

# ═══════════ 通义千问 系列 ═══════════
# MODEL_QWEN_KEY=你的千问_Key
# MODEL_QWEN_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# MODEL_QWEN_ID=qwen-plus

# ═══════════ Ollama 本地（免费）═══════════
# MODEL_OLLAMA_KEY=ollama
# MODEL_OLLAMA_BASE=http://localhost:11434/v1
# MODEL_OLLAMA_ID=gemma4:e4b

# 同供应商多模型（继承）
# MODEL_OLLAMA_QWEN_INHERIT=ollama
# MODEL_OLLAMA_QWEN_ID=qwen35fast

# ══════════════════════════════════════════════════════════════════════
# 上下文管理配置
# ══════════════════════════════════════════════════════════════════════
# Layer 1: MicroCompact — 保留最近 N 条工具输出
CONTEXT_KEEP_RECENT=10
# Layer 3: 自动压缩阈值（估算 token 数，MiniMax 256K 建议设 120000）
CONTEXT_COMPACT_THRESHOLD=120000
# Layer 3: 压缩时保留最近 N 轮完整消息
CONTEXT_COMPACT_KEEP=6

# ══════════════════════════════════════════════════════════════════════
# 工具输出预算（字符上限）
# ══════════════════════════════════════════════════════════════════════
# OUTPUT_MAX_CHARS_READ_FILE=30000
# OUTPUT_MAX_CHARS_RUN_COMMAND=10000
# OUTPUT_MAX_CHARS_SEARCH_CONTENT=8000

# ══════════════════════════════════════════════════════════════════════
# 会话记忆配置
# ══════════════════════════════════════════════════════════════════════
# 每 N 轮保存一次记忆文件（默认每轮都存）
# MEMORY_UPDATE_INTERVAL=1

# ══════════════════════════════════════════════════════════════════════
# 联网搜索配置
# ══════════════════════════════════════════════════════════════════════
SEARCH_ENGINE=duckduckgo
SEARXNG_BASE_URL=http://localhost:8888
SEARCH_FALLBACK=duckduckgo

# ══════════════════════════════════════════════════════════════════════
# RAG 配置
# ══════════════════════════════════════════════════════════════════════
# HF_EMBED_MODEL=BAAI/bge-large-zh-v1.5
# HF_EMBED_DIM=1024
